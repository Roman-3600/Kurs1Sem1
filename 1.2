#include <stdio.h>
#include <math.h>

/**
 * @brief Считывает с клавиатуры значение с плавающей точкой
 * @return Считанное значение
 */
double getDouble();

/**
 * @brief Вычисляет площадь грани куба
 * @param edge длина ребра куба
 * @return Рассчитанная площадь грани
 */
double faceArea(const double edge);

/**
 * @brief Вычисляет площадь полной поверхности куба
 * @param edge длина ребра куба
 * @return Рассчитанная площадь полной поверхности
 */
double totalSurfaceArea(const double edge);

/**
 * @brief Вычисляет объем куба
 * @param edge длина ребра куба
 * @return Рассчитанный объем
 */
double volume(const double edge);

/**
 * @brief Точка входа в программу
 * @return 0, если программа выполнена корректно, иначе не 0
 */
int main()
{
    const double edge = getDouble();
    printf("Площадь грани куба: %.3f\n",faceArea(edge));
    printf("Площадь полной поверхности куба: %.3f\n",totalSurfaceArea(edge));
    printf("Объем куба: %.3f\n",volume(edge));
    return 0;
}

double getDouble()
{
    double val = 0.0;
    scanf("%lf",&val);
    return val;
}

double faceArea(const double edge)
{
    return pow(edge,2);
}

double totalSurfaceArea(const double edge)
{
    return 6 * pow(edge,2);
}

double volume(const double edge)
{
    return pow(edge,3);
}
